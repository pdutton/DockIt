# gofmt requires LF line endings, so keep Go sources LF on every platform.
*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
# systemd and sh read packaging files literally, so a CR would end up in values.
packaging/** text eol=lf
# bash reads the skill's client script literally, so a CR would break it.
skills/dockit/dockit-api text eol=lf
